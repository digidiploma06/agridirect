# Copy to .env and edit. Every value has a safe local default, so .env is optional.

# sqlite (default) or e.g. postgresql+psycopg://user:pass@localhost:5432/agridirect
DATABASE_URL=sqlite:///./data/agridirect.db

# CHANGE THIS before any deployment. Any long random string.
JWT_SECRET=dev-only-change-me-dev-only-change-me

# demo: OTP is printed in this console and returned to the login page.
# sms : OTP is only sent through the SMS provider (see app/sms.py).
OTP_MODE=demo

# synthetic: generated sample mandi/weather data (works offline).
# live     : data.gov.in + Open-Meteo + SoilGrids (needs internet; mandi needs a key).
DATA_MODE=synthetic
DATA_GOV_API_KEY=

# Run ingestion + prediction refresh daily at 02:00 IST while the server is up.
ENABLE_SCHEDULER=true

# Load the demo farmers/companies/listings on first start.
SEED_DEMO=true

# Browser origins allowed to call the API directly (the Next.js dev server proxies, so this is rarely needed).
CORS_ORIGINS=http://localhost:3000
